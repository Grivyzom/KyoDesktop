{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:run": "cargo run --manifest-path dioxus-chat/Cargo.toml --package desktop",
    "desktop:build": "cargo build --manifest-path dioxus-chat/Cargo.toml --package desktop --release",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "rebuild": "powershell -ExecutionPolicy Bypass -File ./scripts/rebuild.ps1",
    "rebuild:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/rebuild.ps1 -Dev",
    "rebuild:release": "powershell -ExecutionPolicy Bypass -File ./scripts/rebuild.ps1 -Release",
    "rebuild:frontend": "powershell -ExecutionPolicy Bypass -File ./scripts/rebuild.ps1 -FrontendOnly",
    "rebuild:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/rebuild.ps1 -BackendOnly",
    "rebuild:run": "powershell -ExecutionPolicy Bypass -File ./scripts/rebuild.ps1 -Run",
    "icon": "node ./scripts/update-icon.mjs",
    "icon:bloub": "node ./scripts/update-icon.mjs --bloub"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "mediabunny": "^1.55.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
